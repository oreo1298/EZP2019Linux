post_install() {
  udevadm control --reload-rules 2>/dev/null || true
  udevadm trigger --subsystem-match=usb --attr-match=idVendor=1fc8 2>/dev/null || true
  echo ":: If your EZP2019+ is plugged in, unplug and replug it once."
}

post_upgrade() {
  post_install
}

post_remove() {
  udevadm control --reload-rules 2>/dev/null || true
}
